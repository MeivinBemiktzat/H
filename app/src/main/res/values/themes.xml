<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AiLocal" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- Splash theme shown instantly at cold start, before Compose takes over.
         Uses the standard windowBackground drawable + layer-list approach,
         compatible back to API 26 (no dependency on SplashScreen API). -->
    <style name="Theme.AiLocal.Splash" parent="Theme.AiLocal">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
